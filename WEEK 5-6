#include <stdio.h>

int main()
{
    float salary[50];
    float total = 0;
    float average;
    float highest;
    float lowest;
    int i;


    for (i = 0; i < 50; i++)
    {
        printf("Enter salary of employee %d: ", i + 1);
        scanf("%f", &salary[i]);
    }

   
    highest = salary[0];
    lowest = salary[0];

   
    for (i = 0; i < 50; i++)
    {
        total = total + salary[i];

        if (salary[i] > highest)
        {
            highest = salary[i];
        }

        if (salary[i] < lowest)
        {
            lowest = salary[i];
        }
    }

    
    average = total / 50;

    printf("\n----- RESULTS -----\n");
    printf("Total salary: %.2f\n", total);
    printf("Average salary: %.2f\n", average);
    printf("Highest salary: %.2f\n", highest);
    printf("Lowest salary: %.2f\n", lowest);

    return 0;
}
