#include <stdio.h>

int main()
{
    float salary[50];
    float total = 0;
    float average;
    float highest;
    float lowest;
    float search;
    float temp;
    int i, j;
    int found = 0;

    for (i = 0; i < 50; i++)
    {
        printf("Enter salary of employee %d: ", i + 1);
        scanf("%f", &salary[i]);
    }

    printf("\n----- ALL SALARIES -----\n");
    for (i = 0; i < 50; i++)
    {
        printf("Employee %d: %.2f\n", i + 1, salary[i]);
    }

    for (i = 0; i < 50; i++)
    {
        total = total + salary[i];
    }
    printf("\nTotal salary expenditure: %.2f\n", total);

    average = total / 50;
    printf("Average salary: %.2f\n", average);

    highest = salary[0];
    for (i = 1; i < 50; i++)
    {
        if (salary[i] > highest)
        {
            highest = salary[i];
        }
    }
    printf("Highest salary: %.2f\n", highest);

    lowest = salary[0];
    for (i = 1; i < 50; i++)
    {
        if (salary[i] < lowest)
        {
            lowest = salary[i];
        }
    }
    printf("Lowest salary: %.2f\n", lowest);

    printf("\nEnter a salary to search for: ");
    scanf("%f", &search);

    for (i = 0; i < 50; i++)
    {
        if (salary[i] == search)
        {
            printf("Salary %.2f found at employee %d\n", search, i + 1);
            found = 1;
        }
    }

    if (found == 0)
    {
        printf("Salary %.2f was not found.\n", search);
    }

    for (i = 0; i < 49; i++)
    {
        for (j = 0; j < 49 - i; j++)
        {
            if (salary[j] > salary[j + 1])
            {
                temp = salary[j];
                salary[j] = salary[j + 1];
                salary[j + 1] = temp;
            }
        }
    }

    printf("\n----- SORTED SALARIES (LOWEST TO HIGHEST) -----\n");
    for (i = 0; i < 50; i++)
    {
        printf("%.2f\n", salary[i]);
    }

    return 0;
}
